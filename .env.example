# --- Runtime -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=true

# --- Deepgram ------------------------------------------------------------
DEEPGRAM_API_KEY=replace-me
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_DIARIZE=false
# Anything longer than this is chunked by this service before upload.
DEEPGRAM_MAX_CHUNK_SECONDS=600
DEEPGRAM_MAX_RETRIES=3

# --- Shared Redis (same instance the other services use) -----------------
REDIS_URL=redis://redis:6379/0
# Must match the BullMQ `prefix` of the producing services.
REDIS_PREFIX=bull

# --- Queues --------------------------------------------------------------
QUEUE_NAME=transcription
QUEUE_EVENTS_NAME=transcription-events
QUEUE_PUBLISH_EVENTS=true
QUEUE_CONCURRENCY=2
QUEUE_LOCK_DURATION_SECONDS=300

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://transcriber:transcriber@postgres:5432/transcriber

# --- Audio ---------------------------------------------------------------
# Shared volume that the producing services write audio into.
AUDIO_ROOT=/data/audio
AUDIO_ENFORCE_ROOT=true
AUDIO_WORK_DIR=/tmp/transcriber
AUDIO_MAX_PARALLEL_CHUNKS=3

# --- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
